    "@latticexyz/explorer": "link:../../packages/explorer",
    "@latticexyz/store-indexer": "link:../../packages/store-indexer",
    "@types/debug": "4.1.7",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "7.1.1",
    "@typescript-eslint/parser": "7.1.1",
    "eslint": "8.57.0",
    "mprocs": "^0.7.3",
    "shx": "^0.3.4",
    "typescript": "5.4.2"
  },
  "engines": {
    "node": "^24",
    "pnpm": "^11"
